# =============================================================================
# Voyara production server env. Copy to server/.env on the deploy host.
# This file is read by ./deploy.sh and by docker-compose at runtime.
# =============================================================================

# --- Docker images ---
# Bumped automatically by the deploy workflow; can be edited by hand for
# rollback. Always use a full tag (never :latest in prod).
BACKEND_IMAGE=docker.io/srinathn2212/voyara-backend:latest
FRONTEND_IMAGE=docker.io/srinathn2212/voyara-frontend:latest

# --- Public origin ---
# The exact URL browsers will use. IP-only deploys leave http:// + port 80.
# When you switch to a domain + TLS, change to https://your.domain and flip
# VOYARA_COOKIE_SECURE=true below.
VOYARA_CORS_ORIGINS=http://CHANGE_ME_PUBLIC_IP
VOYARA_COOKIE_SECURE=false
VOYARA_COOKIE_SAMESITE=Lax

# --- Managed Postgres ---
# Full JDBC URL of your managed DB (RDS / Neon / Supabase / etc.).
# Include ?sslmode=require if your provider requires TLS.
SPRING_DATASOURCE_URL=jdbc:postgresql://CHANGE_ME_DB_HOST:5432/voyara
SPRING_DATASOURCE_USERNAME=voyara
SPRING_DATASOURCE_PASSWORD=CHANGE_ME

# --- JWT ---
# Generate with: openssl rand -base64 48
VOYARA_JWT_SECRET=CHANGE_ME_min_32_chars_high_entropy
VOYARA_JWT_EXPIRATION_MS=86400000

# --- Sign in with Google (optional) ---
# Same value as you used at https://console.cloud.google.com/apis/credentials.
# Leave empty to keep the email/password form as the only sign-in path.
VOYARA_GOOGLE_CLIENT_ID=

# --- Gemini ---
GEMINI_API_KEY=

# --- Optional JVM tuning ---
# JAVA_OPTS=-Xms256m -Xmx512m
