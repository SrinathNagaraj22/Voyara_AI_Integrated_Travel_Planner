# =============================================================================
# Voyara environment variables. Copy this file to .env and fill in real values.
# =============================================================================

# --- Backend: Spring Boot ---

# Active profile: dev (H2 + seed data) | prod (Postgres, no seed)
SPRING_PROFILES_ACTIVE=dev

# JWT signing secret. MUST be at least 32 characters of high entropy in prod.
# Generate with:  openssl rand -base64 48
VOYARA_JWT_SECRET=dev-only-secret-please-override-in-production-min-32-chars

# JWT lifetime in milliseconds (default 24h)
VOYARA_JWT_EXPIRATION_MS=86400000

# Auth cookie hardening. Set both to true in production (HTTPS only).
VOYARA_COOKIE_SECURE=false
VOYARA_COOKIE_SAMESITE=Lax

# Comma-separated allowed CORS origins (no trailing slash)
VOYARA_CORS_ORIGINS=http://localhost:3000

# --- Sign in with Google (optional) ---
# Create an OAuth Client ID at https://console.cloud.google.com/apis/credentials
#   - Application type: Web application
#   - Authorized JavaScript origins: http://localhost:3000  (and your prod origin)
# Set the same value for the backend (VOYARA_GOOGLE_CLIENT_ID) and the frontend
# build (VITE_GOOGLE_CLIENT_ID). Leave both empty to disable Google sign-in.
VOYARA_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# --- Database ---
# Dev profile reads these too; defaults match the docker-compose Postgres
# (POSTGRES_USER=voyara, POSTGRES_PASSWORD=voyara). Change all three together
# if you rotate them.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/voyara
SPRING_DATASOURCE_USERNAME=voyara
SPRING_DATASOURCE_PASSWORD=voyara

# --- Gemini AI ---
GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent
